---
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileChrome from '../components/MobileChrome.astro';
import { dictionaries } from '../i18n';
import type { EditorialPage } from '../data/editorial';
interface Props {
  page: EditorialPage;
}
const { page } = Astro.props;
const t = dictionaries[page.lang];
// Section label from the route, so the trail stays truthful in every locale.
const segments = Astro.url.pathname.split('/').filter(Boolean);
const section = segments[1];
const sectionName =
  section === 'products'
    ? t.catalogue
    : section === 'collections'
      ? t.knowledge
      : undefined;
const suffix = segments.slice(2).join('/');
const breadcrumbs = [
  ...(sectionName && suffix
    ? [{ name: sectionName, path: `/${page.lang}/${section}/` }]
    : []),
  { name: page.title, path: Astro.url.pathname },
];
---

<BaseLayout
  lang={page.lang}
  title={page.title}
  description={page.description}
  pageSchema={page.pageSchema}
  socialImage={page.socialImage}
  breadcrumbs={breadcrumbs}
>
  <SiteHeader lang={page.lang} />
  <main id="main" tabindex="-1" class="editorial-main">
    <article class:list={['wrap section', `content-${page.kind}`]}>
      <a class="text-link" href={`/${page.lang}/#ritual`}>
        <ArrowIcon direction="left" /> {t.backDiscovery}
      </a>
      <header class="editorial-heading">
        <p class="eyebrow">MARIYAS NATURALS / {t.journal}</p>
        <h1 lang={page.titleLang}>{page.title}</h1>
        <p class="lede">{page.description}</p>
        {!page.reviewed && <p class="editor-note">{t.preview}</p>}
      </header>
      <slot />
      {page.sources.length > 0 && (
        <section class="source-notes">
          <h2>{t.verification}</h2>
          <ul>
            {page.sources.map((source) => (
              <li>
                <a href={source.url}>{source.title}</a>{' '}
                <time datetime={source.accessedOn}>{source.accessedOn}</time>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </main>
  <SiteFooter lang={page.lang} />
  <MobileChrome lang={page.lang} />
</BaseLayout>
