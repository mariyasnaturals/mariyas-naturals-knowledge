---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageLanding from '../components/LanguageLanding.astro';
import { dictionaries } from '../i18n';
---

<BaseLayout
  lang="en"
  title="Choose your language"
  description={dictionaries.en.description}
  path="/"
>
  <LanguageLanding
    eyebrow="MARIYAS NATURALS"
    headline="Rooted in Nature. Guided by Tradition."
    lede="Choose your language to explore Mariyas Naturals — herbal hair care, skin care and everyday wellness from Kerala."
    label="Choose language"
    photoAlt="A model in a bright pink floral sari with long black hair, seated in an ornate carved wooden chair against a deep green botanical studio backdrop."
    footnote="Five languages. One collection. Purchases are completed on our official store."
  />
</BaseLayout>
