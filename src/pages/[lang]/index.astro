---
/**
 * The language homepage. `/` renders the same body (see src/pages/index.astro),
 * so English is reachable both at the root and at /en/ — with the root canonical
 * pointing at /en/ and every locale declaring the full hreflang set.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MobileChrome from '../../components/MobileChrome.astro';
import HomeHero from '../../components/HomeHero.astro';
import HomeSections from '../../components/living/HomeSections.astro';
import LanguageSuggestion from '../../components/living/LanguageSuggestion.astro';
import { locales, dictionaries, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = dictionaries[lang];
---

<BaseLayout lang={lang} title={t.title} description={t.description}>
  <LanguageSuggestion lang={lang} />
  <SiteHeader lang={lang} route="home" />
  <main id="main" tabindex="-1">
    <HomeHero t={t} />
    <HomeSections t={t} lang={lang} />
  </main>
  <SiteFooter lang={lang} />
  <MobileChrome lang={lang} />
</BaseLayout>
