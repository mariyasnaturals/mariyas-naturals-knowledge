---
import ArrowIcon from '../../components/ArrowIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import HeroSection from '../../components/HeroSection.astro';
import StorytellingSection from '../../components/StorytellingSection.astro';
import IngredientPreview from '../../components/IngredientPreview.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProductCard from '../../components/ProductCard.astro';
import CollectionHighlights from '../../components/CollectionHighlights.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { featuredProduct, featuredProducts } from '../../data/products';
import { socialImage } from '../../data/seo';
import { locales, dictionaries, type Locale } from '../../i18n';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = dictionaries[lang];
---

<BaseLayout
  lang={lang}
  title={t.title}
  description={t.description}
  socialImage={socialImage(featuredProduct.images.main, lang)}
>
  <SiteHeader lang={lang} t={t} />
  <main id="main" tabindex="-1">
    <HeroSection t={t} lang={lang} />
    <StorytellingSection t={t} lang={lang} />
    <IngredientPreview t={t} />
    <CollectionHighlights t={t} lang={lang} />
    <section id="products" class="product-section section">
      <div class="wrap">
        <SectionHeading
          eyebrow={t.productLabel}
          title={t.productTitle}
          text={t.productText}
        />
        <div
          class="product-rail"
          tabindex="0"
          role="region"
          aria-label={t.products}
        >
          {featuredProducts.map((product) => (
            <ProductCard product={product} t={t} lang={lang} />
          ))}
        </div>
        <a class="button catalogue-link" href={`/${lang}/products/`}>
          {t.allProducts} <ArrowIcon />
        </a>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} t={t} />
</BaseLayout>
