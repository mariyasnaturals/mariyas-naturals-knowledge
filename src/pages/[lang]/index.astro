---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import HeroSection from '../../components/HeroSection.astro';
import StorytellingSection from '../../components/StorytellingSection.astro';
import IngredientPreview from '../../components/IngredientPreview.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProductCard from '../../components/ProductCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { products } from '../../data/products';
import { locales, dictionaries, type Locale } from '../../i18n';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = dictionaries[lang];
---

<BaseLayout lang={lang} title={t.title} description={t.description}>
  <SiteHeader lang={lang} t={t} />
  <main id="main" tabindex="-1">
    <HeroSection t={t} lang={lang} />
    <StorytellingSection t={t} lang={lang} />
    <IngredientPreview t={t} />
    <section id="knowledge" class="section wrap">
      <SectionHeading
        eyebrow={t.knowledgeLabel}
        title={t.knowledgeTitle}
        text={t.knowledgeText}
      />
      <div class="three-grid">
        {t.knowledgeItems.map((title, i) => (
          <article class="knowledge-card">
            <span class="scene-number" aria-hidden="true">
              0{i + 1}
            </span>
            <h3>{title}</h3>
            <p>{t.coming}</p>
          </article>
        ))}
      </div>
    </section>
    <section id="products" class="product-section section">
      <div class="wrap">
        <SectionHeading
          eyebrow={t.productLabel}
          title={t.productTitle}
          text={t.productText}
        />
        {products.map((product) => (
          <ProductCard product={product} t={t} lang={lang} />
        ))}
        <details id="hair-oil-example" class="product-details">
          <summary>{t.detail}</summary>
          <p>{t.detailText}</p>
        </details>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} t={t} />
</BaseLayout>
