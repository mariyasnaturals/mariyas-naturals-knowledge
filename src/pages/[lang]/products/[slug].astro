---
import ArrowIcon from '../../../components/ArrowIcon.astro';
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import ProductVisual from '../../../components/ProductVisual.astro';
import { products, purchaseUrl, type Product } from '../../../data/products';
import { locales, dictionaries, type Locale } from '../../../i18n';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    products.map((product) => ({
      params: { lang, slug: product.slug },
      props: { product },
    })),
  );
}
interface Props {
  product: Product;
}
const { product } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = dictionaries[lang];
const buyUrl = purchaseUrl(product);
---

<EditorialLayout
  page={{
    kind: 'product',
    lang,
    title: product.name[lang],
    titleLang: 'en',
    description: `${product.name[lang]} · ${product.description[lang]}`,
    sources: [],
    reviewed: true,
  }}
>
  <div class="product-detail-grid">
    <div class="product-detail-media">
      <ProductVisual product={product} lang={lang} t={t} priority />
      {product.images.gallery.length > 0 && (
        <section class="gallery-section" aria-label={t.gallery}>
          <h2>{t.gallery}</h2>
          <p class="gallery-hint">{t.galleryHint}</p>
          <ol class="image-gallery" tabindex="0" aria-label={t.gallery}>
            {product.images.gallery.map((image, index) => (
              <li
                id={
                  product.variants.find((v) => v.images[0]?.id === image.id)?.id
                }
              >
                <figure>
                  <img
                    src={image.src}
                    srcset={image.variants
                      .map((v) => `${v.src} ${v.width}w`)
                      .join(', ')}
                    sizes="(min-width: 760px) 360px, 75vw"
                    alt={image.alt[lang]}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    <span lang="en">{image.variantAssociation}</span> ·{' '}
                    {String(index + 1).padStart(2, '0')} /{' '}
                    {String(product.images.gallery.length).padStart(2, '0')}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>
    <div class="product-facts">
      <p class="eyebrow">{t.categories[product.category]}</p>
      <h2>{t.detail}</h2>
      <p>{t.detailText}</p>
      {product.variants.length > 0 && (
        <section class="product-variants" aria-label={t.sizesLabel}>
          <h2>{t.sizesLabel}</h2>
          <ul class="size-options">
            {product.variants.map((variant) => (
              <li>
                {variant.images.length ? (
                  <a href={`#${variant.id}`} lang="en">
                    {variant.label} <ArrowIcon direction="down" />
                  </a>
                ) : (
                  <span lang="en">{variant.label}</span>
                )}
              </li>
            ))}
          </ul>
          {product.variants
            .filter((v) => !v.images.length)
            .map((variant) => (
              <p class="editor-note">
                <span lang="en">{variant.label}</span> · {t.variantNoImage}
              </p>
            ))}
        </section>
      )}
      {buyUrl ? (
        <a class="button" href={buyUrl}>
          {t.buy}
        </a>
      ) : (
        <p class="commerce-status">{t.commercePending}</p>
      )}
      <a class="text-link" href={`/${lang}/products/`}>
        {t.allProducts} <ArrowIcon />
      </a>
      <details class="provenance-details">
        <summary>{t.verification}</summary>
        <p>
          {t.sourceVerified} ·{' '}
          <time datetime={product.verifiedOn}>{product.verifiedOn}</time>
        </p>
        <ul>
          {product.sources.map((source) => (
            <li>
              <a href={source.url} data-source-reference lang="en">
                {new URL(source.url).hostname} · {source.name}
              </a>
              <small lang="en">
                {' '}
                ID {source.id}
                {source.sku && ` · SKU ${source.sku}`}
              </small>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </div>
</EditorialLayout>
