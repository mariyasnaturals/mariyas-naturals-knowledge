---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import ProductVisual from '../../../components/ProductVisual.astro';
import { products, purchaseUrl, type Product } from '../../../data/products';
import { locales, dictionaries, type Locale } from '../../../i18n';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    products.map((product) => ({
      params: { lang, slug: product.slug },
      props: { product },
    })),
  );
}
interface Props {
  product: Product;
}
const { product } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = dictionaries[lang];
const buyUrl = purchaseUrl(product);
---

<EditorialLayout
  page={{
    kind: 'product',
    lang,
    title: product.name[lang],
    description: product.description[lang],
    sources: [],
    reviewed: product.verified,
  }}
>
  <div class="product-detail-grid">
    <div>
      <ProductVisual product={product} lang={lang} t={t} priority />
      {product.images.gallery.length > 0 && (
        <section aria-label={t.gallery} class="image-gallery" tabindex="0">
          {product.images.gallery.map((image) => (
            <img
              src={image.src}
              srcset={
                image.variants.map((v) => `${v.src} ${v.width}w`).join(', ') ||
                undefined
              }
              sizes="(min-width: 760px) 30vw, 80vw"
              alt={image.alt[lang]}
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
            />
          ))}
        </section>
      )}
    </div>
    <div class="product-facts">
      <p class="eyebrow">{t.demo}</p>
      <h2>{t.detail}</h2>
      <p>{t.detailText}</p>
      <h2>{t.verification}</h2>
      <p>{product.verified ? product.name[lang] : t.unverified}</p>
      {product.sku && <p>SKU: {product.sku}</p>}
      {buyUrl ? (
        <a class="button" href={buyUrl}>
          {t.buy}
        </a>
      ) : (
        <p class="commerce-status">{t.commercePending}</p>
      )}
      <a class="text-link" href={`/${lang}/#ingredients`}>
        {t.exploreIngredients} →
      </a>
    </div>
  </div>
</EditorialLayout>
