---
import ArrowIcon from '../../../components/ArrowIcon.astro';
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import CatalogueGrid from '../../../components/CatalogueGrid.astro';
import { collectionSchema } from '../../../data/seo';
import { collectionPath } from '../../../data/collections';
import { products } from '../../../data/products';
import type { ProductCategory } from '../../../data/media-types';
import { locales, dictionaries, type Locale } from '../../../i18n';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = dictionaries[lang];
const categories = Object.keys(t.categories) as ProductCategory[];
---

<EditorialLayout
  page={{
    kind: 'product',
    lang,
    title: t.catalogueTitle,
    description: t.catalogueText,
    sources: [],
    reviewed: true,
    pageSchema: collectionSchema(products, lang),
  }}
>
  <nav class="collection-nav" aria-label={t.catalogue}>
    {categories.map((category) => (
      <a href={`#${category}`}>
        {t.categories[category]}{' '}
        <span>{products.filter((p) => p.category === category).length}</span>
      </a>
    ))}
  </nav>
  {categories.map((category) => (
    <section
      id={category}
      class="catalogue-collection"
      aria-labelledby={`heading-${category}`}
    >
      <h2 id={`heading-${category}`}>
        <a href={collectionPath(lang, category)}>
          {t.categories[category]} <ArrowIcon />
        </a>
      </h2>
      <CatalogueGrid
        products={products.filter((p) => p.category === category)}
        t={t}
        lang={lang}
      />
    </section>
  ))}
</EditorialLayout>
