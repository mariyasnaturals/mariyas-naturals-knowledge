---
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNavigation from './MobileNavigation.astro';
import type { Locale, Dictionary } from '../i18n';
interface Props {
  lang: Locale;
  t: Dictionary;
}
const { lang, t } = Astro.props;
---

<section id="store" class="store-section section" aria-label={t.storeShort}>
  <div class="wrap">
    <p class="eyebrow">{t.nextChapter}</p>
    <h2>{t.storeTitle}</h2>
    <p>{t.storeText}</p>
    <p class="commerce-status">
      <span aria-hidden="true">◇</span> {t.commercePending}
    </p>
    <a class="button button-gold" href={`/${lang}/#products`}>
      {t.catalogue} →
    </a>
  </div>
</section>
<footer class="site-footer wrap">
  <div>
    <a class="footer-brand" href={`/${lang}/`}>
      Mariyas Naturals
    </a>
    <p>{t.footer}</p>
  </div>
  <LanguageSwitcher lang={lang} label={t.language} />
  <p class="footer-note">
    © {new Date().getFullYear()} {t.rights}. {t.preview}
  </p>
</footer>
<MobileNavigation lang={lang} t={t} />
