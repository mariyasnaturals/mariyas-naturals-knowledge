---
/**
 * The one footer used by every route.
 *
 * Contents are limited to what has been verified:
 *   - full postal address, enquiry email, exactly one WhatsApp number
 *   - Instagram (opened and read) and Facebook (declared in the store's own
 *     Organization data)
 *   - collection links that exist locally
 *   - Google Maps stays an honest "to be confirmed" note until the owner supplies
 *     the exact business listing URL. Never a guessed link.
 */
import BrandMark from './living/BrandMark.astro';
import { dictionaries, type Locale } from '../i18n';
import { footerCopy } from '../data/living-copy';
import { collectionKeys, collectionPath } from '../data/collections';
import {
  whatsapp,
  email,
  postalAddress,
  social,
  googleBusiness,
} from '../data/site-contact';
import { storeLinks } from '../data/store';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = dictionaries[lang];
const c = footerCopy[lang];
const year = new Date().getFullYear();

/** Only categories that actually have a built route on this site. */
const collections = collectionKeys
  .filter((key) => key !== 'combo')
  .map((key) => ({
    href: collectionPath(lang, key),
    label: t.categories[key],
  }));
---

<footer class="lg-footer" id="site-footer">
  <div class="lg-shell">
    <div class="lg-footer__top">
      <div class="lg-footer__brand">
        <BrandMark href={`/${lang}/`} inverse />
        <p class="lg-footer__tagline">{c.tagline}</p>
        <p class="lg-footer__hint" style="margin-top:.75rem">
          {c.storeNote}
        </p>
      </div>

      <div>
        <h2>{c.addressLabel}</h2>
        <address>{postalAddress.display}</address>
        <ul style="margin-top:.55rem">
          <li>
            <span class="lg-footer__hint">{c.emailLabel}</span>
            <a href={email.href}>{email.display}</a>
          </li>
          <li>
            <span class="lg-footer__hint">{c.whatsappLabel}</span>
            <a href={whatsapp.href} rel="noopener">
              {whatsapp.display}
            </a>
            <span class="lg-footer__hint">{c.whatsappHint}</span>
          </li>
          <li>
            <span class="lg-footer__hint">{c.mapsLabel}</span>
            {googleBusiness.href ? (
              <a href={googleBusiness.href} rel="noopener">
                {c.mapsLabel}
              </a>
            ) : (
              <span class="lg-footer__pending">{c.mapsPending}</span>
            )}
          </li>
        </ul>
      </div>

      <div>
        <h2>{c.collectionsLabel}</h2>
        <ul>
          {collections.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
          <li>
            <a href={`/${lang}/products/`}>{t.catalogue}</a>
          </li>
        </ul>

        <h2 style="margin-top:1.1rem">{c.socialLabel}</h2>
        <ul>
          <li>
            <a href={social.instagram.href} rel="noopener">
              {c.instagram}
            </a>
          </li>
          <li>
            <a href={social.facebook.href} rel="noopener">
              {c.facebook}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2>{c.legalLabel}</h2>
        <ul>
          <li>
            <a href={storeLinks.shop} rel="noopener">
              {t.shopProducts}
            </a>
          </li>
          {c.legal.map((line) => (
            <li>
              <span class="lg-footer__hint">{line}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="lg-footer__bottom">
      <p style="margin:0">
        © {year} {t.rights}. {c.rights}
      </p>
      <ul class="lg-footer__legal">
        <li>Mariyas Naturals</li>
        <li>{postalAddress.display.split(', ').slice(-2).join(', ')}</li>
      </ul>
    </div>
  </div>
</footer>
