---
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale, Dictionary } from '../i18n';
interface Props {
  lang: Locale;
  t: Dictionary;
}
const { lang, t } = Astro.props;
const cinematicHomepage = Astro.url.pathname === `/${lang}/`;
---

<footer class="site-footer wrap">
  <div>
    <a class="footer-brand" href={`/${lang}/`} lang="en">
      Mariyas Naturals
    </a>
    <p>{t.footer}</p>
  </div>
  <LanguageSwitcher lang={lang} label={t.language} compact />
  <p class="footer-note">
    © {new Date().getFullYear()} {t.rights}. {!cinematicHomepage && t.preview}
  </p>
</footer>
