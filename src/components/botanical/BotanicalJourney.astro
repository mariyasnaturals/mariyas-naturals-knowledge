---
import type { Locale } from '../../i18n';
import ArrowIcon from '../ArrowIcon.astro';
import BotanicalExtractor from './BotanicalExtractor.astro';
import { journeyCopy } from './content';
import { studies, stages } from './motion.mjs';
import originals from '../../data/cinematic-assets.json';
import botanicalManifest from '../../data/botanical-media.json';
import { featuredProduct } from '../../data/products';
import './journey.css';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const registered = new Set(
  botanicalManifest.media.map((m) => m.localAssetPath),
);
const authenticProduct = botanicalManifest.media.find(
  (m) => m.role === 'photographic-product-cutout',
)!;
if (!originals.references.product.src.includes('original-product'))
  throw new Error(
    'The photographic product reveal must stay the owner original',
  );
const t = journeyCopy[lang];
// Truthful localized alt text comes from the same registered review record.
const altFor = (name: string) => {
  const record = botanicalManifest.media.find(
    (m) => m.localAssetPath === `/_botanical-assets/${name}`,
  );
  if (!record) throw new Error(`Unregistered botanical media: ${name}`);
  return record.alt[lang];
};
// Every served layer must be one of the 43 reviewed botanical registrations.
const asset = (name: string) => {
  const path = `/_botanical-assets/${name}`;
  if (!registered.has(path))
    throw new Error(`Unregistered botanical media: ${path}`);
  return path;
};
// The journey is eight real sections in normal document flow. `travel` is each
// scene's own scroll runway, expressed as a fraction of a viewport height; it is
// added to the scene box so the scene's animation has room to play while the
// page itself keeps moving. Nothing is pinned or sticky.
const sceneStyle = (travel: number) => `--scene-travel:${travel}`;
const scene = (name: string) => stages.find((s) => s.scene === name)!;
// Approved call to action stays inside the reviewed static site. The current .in
// product page remains the visible source reference; purchasing stays disabled.
const destination = `/${lang}/products/${featuredProduct.slug}/`;
// Ingredients used in the convergence scene, drawn from the same registered set.
const converging = studies.filter((_, index) => index % 3 === 0);
---

<section
  class="botanical-journey"
  id="botanical-journey"
  aria-labelledby="botanical-title"
  data-botanical-journey
  data-lang={lang}
>
  <h2 id="botanical-title" class="sr-only">
    {t.intro}
  </h2>
  <div class="botanical-track">
    <!--
      Journey-bounded sticky foreground: the bottle is the stable focal point.
      It sticks inside this track only — it enters as the journey begins and
      releases as the journey ends, and the rest of the site scrolls normally.
      The chapters move behind and around it; it never travels with a scene.
    -->
    <div class="botanical-bottle-layer" data-bottle-layer aria-hidden="true">
      <div class="botanical-bottle-stage">
        <div class="botanical-bottle-halo" data-bottle-halo></div>
        <div class="botanical-bottle-frame" data-bottle-frame>
          <div class="botanical-product-glow"></div>
          <div class="botanical-product" data-layer="product">
            <img
              data-botanical-media
              src={asset('authentic-product-cutout.webp')}
              width="245"
              height="745"
              alt={altFor('authentic-product-cutout.webp')}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>

    <!--
      Eight scenes, each a real section in document flow. Scrolling moves the
      whole page: a scene travels up and out, the next one physically enters from
      below. No sticky master stage, no pinned viewport, no translated world box.
    -->
    <!-- 1 · Origin ------------------------------------------------ -->
    <section
      class="botanical-scene botanical-scene--origin"
      data-scene="origin"
      data-botanical-step={0}
      data-botanical-stage="1"
      aria-label={t.titles[0]}
      style={sceneStyle(scene('origin').travel)}
    >
      <div class="botanical-scene-inner">
        <div class="botanical-scene-art" aria-hidden="true">
          <picture class="botanical-canopy">
            <source
              media="(max-width: 759px)"
              srcset={asset('botanical-origin-mobile.webp')}
            />
            <img
              data-botanical-media
              src={asset('botanical-origin-desktop.webp')}
              width="1920"
              height="1080"
              alt={altFor('botanical-origin-desktop.webp')}
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="botanical-grove">
            <i class="botanical-stem"></i>
            <i class="botanical-stem"></i>
            <i class="botanical-stem"></i>
            <i class="botanical-stem"></i>
            <i class="botanical-stem"></i>
          </div>
        </div>
        <div class="botanical-copy">
          <!-- "From nature. With care." opens the journey itself, never a
               separate full-height panel above it. -->
          <p class="botanical-overture" data-scene-intro>
            {t.intro}
          </p>
          <p class="eyebrow">{t.label}</p>
          <h3>{t.titles[0]}</h3>
          <p>{t.lines[0]}</p>
          <p class="botanical-note">{t.note}</p>
        </div>
      </div>
    </section>

    <!-- 2 · Botanical studies ------------------------------------- -->
    <section
      class="botanical-scene botanical-scene--studies"
      data-scene="studies"
      data-botanical-step={1}
      data-botanical-stage="2"
      aria-label={t.titles[1]}
      style={sceneStyle(scene('studies').travel)}
    >
      <div class="botanical-scene-inner">
        <div
          class="botanical-scene-art botanical-scene-art--flat"
          aria-hidden="true"
        >
          {studies.map((study) => (
            <img
              data-botanical-media
              src={asset(`${study.id}.webp`)}
              width="320"
              height="420"
              alt={altFor(`${study.id}.webp`)}
              loading="lazy"
              decoding="async"
              class="botanical-study"
              data-study={study.id}
              data-group={study.group}
              style={`--study-x:${study.x.toFixed(2)}%;--study-y:${study.y}%;--enter-x:${study.enterX}%`}
            />
          ))}
        </div>
        <div class="botanical-copy">
          <p class="eyebrow">{t.label}</p>
          <h3>{t.titles[1]}</h3>
          <p>{t.lines[1]}</p>
        </div>
      </div>
    </section>

    <!-- 3 · Convergence ------------------------------------------- -->
    <section
      class="botanical-scene botanical-scene--convergence"
      data-scene="convergence"
      data-botanical-step={2}
      data-botanical-stage="3"
      aria-label={t.titles[2]}
      style={sceneStyle(scene('convergence').travel)}
    >
      <div class="botanical-scene-inner">
        <div
          class="botanical-scene-art botanical-scene-art--flat"
          aria-hidden="true"
        >
          <div class="botanical-convergence-halo"></div>
          {converging.map((study, index) => (
            <img
              data-botanical-media
              src={asset(`${study.id}.webp`)}
              width="320"
              height="420"
              alt={altFor(`${study.id}.webp`)}
              loading="lazy"
              decoding="async"
              class="botanical-ingredient"
              data-converge={index}
              style={`--angle:${(index * 36).toFixed(1)}deg`}
            />
          ))}
          <div class="botanical-convergence-vessel">
            <img
              data-botanical-media
              src={asset('brass-kinnam.webp')}
              width="600"
              height="600"
              alt={altFor('brass-kinnam.webp')}
              loading="lazy"
            />
          </div>
        </div>
        <div class="botanical-copy">
          <p class="eyebrow">{t.label}</p>
          <h3>{t.titles[2]}</h3>
          <p>{t.lines[2]}</p>
        </div>
      </div>
    </section>

    <!-- 4 · Preparation ------------------------------------------- -->
    <section
      class="botanical-scene botanical-scene--preparation"
      data-scene="preparation"
      data-botanical-step={3}
      data-botanical-stage="4"
      aria-label={t.titles[3]}
      style={sceneStyle(scene('preparation').travel)}
    >
      <div class="botanical-scene-inner">
        <div class="botanical-scene-art">
          <!-- Preparation bench: material is cut and ground in the mortar. -->
          <div
            class="botanical-mortar"
            data-layer="mortar"
            data-vessel="preparation-mortar"
          >
            <div class="botanical-mortar-body">
              <img
                data-botanical-media
                src={asset('preparation-device.webp')}
                width="760"
                height="620"
                alt={altFor('preparation-device.webp')}
                loading="lazy"
              />
            </div>
            <img
              data-botanical-media
              class="botanical-pestle"
              data-layer="pestle"
              src={asset('preparation-pestle.webp')}
              width="280"
              height="680"
              alt={altFor('preparation-pestle.webp')}
              loading="lazy"
            />
            <img
              data-botanical-media
              class="botanical-fragments"
              data-layer="fragments"
              src={asset('preparation-fragments.webp')}
              width="420"
              height="280"
              alt={altFor('preparation-fragments.webp')}
              loading="lazy"
            />
            <div class="botanical-cut" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>
            <div class="botanical-paste" data-layer="paste"></div>
          </div>
        </div>
        <div class="botanical-copy">
          <p class="eyebrow">{t.label}</p>
          <h3>{t.titles[3]}</h3>
          <p>{t.lines[3]}</p>
        </div>
      </div>
    </section>

    <!-- 5 · Extraction -------------------------------------------- -->
    <section
      class="botanical-scene botanical-scene--extraction"
      data-scene="extraction"
      data-botanical-step={4}
      data-botanical-stage="5"
      aria-label={t.titles[4]}
      style={sceneStyle(scene('extraction').travel)}
    >
      <div class="botanical-scene-inner">
        <div class="botanical-scene-art">
          <!-- Extraction bench: ground material feeds the brass filter, fine green
               herbal liquid leaves its outlet and enters the kinnam below. -->
          <div class="botanical-filter-station" data-layer="filter-station">
            <BotanicalExtractor animated lang={lang} />
            <div
              class="botanical-apparatus botanical-receiver"
              data-layer="receiver"
              data-vessel="brass-kinnam"
            >
              <div class="botanical-liquid-aperture">
                <div class="botanical-fill" data-layer="fill"></div>
              </div>
              <img
                data-botanical-media
                src={asset('brass-kinnam.webp')}
                width="600"
                height="600"
                alt={altFor('brass-kinnam.webp')}
                loading="lazy"
              />
            </div>
            <div
              class="botanical-extract-stream"
              data-layer="extract-stream"
            ></div>
            <div class="botanical-extract-pool" data-layer="extract-pool"></div>
          </div>
        </div>
        <div class="botanical-copy">
          <p class="eyebrow">{t.label}</p>
          <h3>{t.titles[4]}</h3>
          <p>{t.lines[4]}</p>
        </div>
      </div>
    </section>

    <!-- 6 · Oil --------------------------------------------------- -->
    <section
      class="botanical-scene botanical-scene--oil"
      data-scene="oil"
      data-botanical-step={5}
      data-botanical-stage="6"
      aria-label={t.titles[5]}
      style={sceneStyle(scene('oil').travel)}
    >
      <div class="botanical-scene-inner">
        <div class="botanical-scene-art">
          <div
            class="botanical-apparatus botanical-copper"
            data-layer="copper"
            data-vessel="brass-uruli"
          >
            <img
              data-botanical-media
              src={asset('brass-uruli.webp')}
              width="900"
              height="600"
              alt={altFor('brass-uruli.webp')}
              loading="lazy"
            />
            <div class="botanical-liquid-aperture botanical-uruli-aperture">
              <div class="botanical-fill" data-layer="uruli-fill"></div>
            </div>
            <div class="botanical-ripples" data-layer="ripples">
              <img
                data-botanical-media
                src={asset('liquid-reflections.webp')}
                width="600"
                height="280"
                alt={altFor('liquid-reflections.webp')}
                loading="lazy"
              />
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
        </div>
        <div class="botanical-copy">
          <p class="eyebrow">{t.label}</p>
          <h3>{t.titles[5]}</h3>
          <p>{t.lines[5]}</p>
        </div>
      </div>
    </section>

    <!-- 7 · Transfer ---------------------------------------------- -->
    <section
      class="botanical-scene botanical-scene--transfer"
      data-scene="transfer"
      data-botanical-step={6}
      data-botanical-stage="7"
      aria-label={t.titles[6]}
      style={sceneStyle(scene('transfer').travel)}
    >
      <div class="botanical-scene-inner">
        <div class="botanical-scene-art">
          <div
            class="botanical-apparatus botanical-copper botanical-copper--target"
            data-layer="target"
            data-vessel="brass-uruli"
          >
            <img
              data-botanical-media
              src={asset('brass-uruli.webp')}
              width="900"
              height="600"
              alt={altFor('brass-uruli.webp')}
              loading="lazy"
            />
            <div class="botanical-liquid-aperture botanical-uruli-aperture">
              <div class="botanical-fill" data-layer="target-fill"></div>
            </div>
          </div>
          <!-- The stream and its droplet are children of the pouring vessel, so
               they can never detach from the spout that emits them. -->
          <div
            class="botanical-pourer"
            data-layer="pourer"
            data-vessel="brass-pourer"
          >
            <img
              data-botanical-media
              src={asset('brass-pourer.webp')}
              width="800"
              height="600"
              alt={altFor('brass-pourer.webp')}
              loading="lazy"
            />
            <img
              data-botanical-media
              class="botanical-stream"
              data-layer="stream"
              src={asset('dark-oil-stream.webp')}
              width="150"
              height="800"
              alt={altFor('dark-oil-stream.webp')}
              loading="lazy"
            />
            <img
              data-botanical-media
              class="botanical-drop"
              data-layer="drop"
              src={asset('dark-oil-droplet.webp')}
              width="160"
              height="240"
              alt={altFor('dark-oil-droplet.webp')}
              loading="lazy"
            />
          </div>
        </div>
        <div class="botanical-copy">
          <p class="eyebrow">{t.label}</p>
          <h3>{t.titles[6]}</h3>
          <p>{t.lines[6]}</p>
        </div>
      </div>
    </section>

    <!-- 8 · Reveal ------------------------------------------------ -->
    <section
      class="botanical-scene botanical-scene--reveal"
      data-scene="reveal"
      data-botanical-step={7}
      data-botanical-stage="8"
      id="botanical-finale"
      aria-label={t.titles[7]}
      style={sceneStyle(scene('reveal').travel)}
    >
      <div class="botanical-scene-inner">
        <div class="botanical-scene-art">
          <!-- The bottle itself is the sticky foreground layer above; this scene
               frames it with light rather than repeating it. -->
          <div class="botanical-finale-halo" aria-hidden="true"></div>
        </div>
        <div class="botanical-copy">
          <p class="eyebrow">{t.label}</p>
          <h3>{t.titles[7]}</h3>
          <p>{t.lines[7]}</p>
          <span class="sr-only">{authenticProduct.alt[lang]}</span>
          <p class="botanical-claim">
            <span>60</span> <span>Natural Ingredients</span>
          </p>
          <a class="botanical-cta" href={destination}>
            {t.discover} <ArrowIcon />
          </a>
        </div>
      </div>
    </section>
  </div>
</section>
<script>
  import { mountBotanicalJourney } from './journey';
  document
    .querySelectorAll<HTMLElement>('[data-botanical-journey]')
    .forEach(mountBotanicalJourney);
</script>
