---
import ArrowIcon from './ArrowIcon.astro';
import ApprovedImage from './ApprovedImage.astro';
import {
  showcaseItems,
  browseGroups,
  productHref,
  groupCopy,
} from '../data/showcase';
import { storeLinks } from '../data/store';
import type { Dictionary, Locale } from '../i18n';
interface Props {
  t: Dictionary;
  lang: Locale;
}
const { t, lang } = Astro.props;

/** Factual, format-only descriptions. No benefit, cure or certification claims. */
const descriptions: Record<string, Record<Locale, string>> = {
  'hair-oil-200-ml': {
    en: 'Herbal hair care oil in the 200 ml pack, with botanical ingredients in a coconut-oil base.',
    ml: '200 ml പായ്ക്കിലെ ഹെർബൽ ഹെയർ കെയർ ഓയിൽ, തേങ്ങാഎണ്ണ അടിസ്ഥാനത്തിൽ സസ്യചേരുവകളോടെ.',
    hi: '200 ml पैक में हर्बल हेयर केयर ऑयल, नारियल तेल आधार में वनस्पति सामग्री के साथ।',
    ta: '200 ml பாக்கில் ஹெர்பல் ஹேர் கேர் ஆயில், தேங்காய் எண்ணெய் அடிப்படையில் தாவரப் பொருட்களுடன்.',
    kn: '200 ml ಪ್ಯಾಕ್‌ನಲ್ಲಿ ಹೆರ್ಬಲ್ ಹೇರ್ ಕೇರ್ ಆಯಿಲ್, ತೆಂಗಿನ ಎಣ್ಣೆ ಆಧಾರದಲ್ಲಿ ಸಸ್ಯ ಪದಾರ್ಥಗಳೊಂದಿಗೆ.',
  },
  'hair-oil-500-ml': {
    en: 'The larger 500 ml pack of the same herbal hair care oil.',
    ml: 'അതേ ഹെർബൽ ഹെയർ കെയർ ഓയിലിന്റെ വലിയ 500 ml പായ്ക്ക്.',
    hi: 'उसी हर्बल हेयर केयर ऑयल का बड़ा 500 ml पैक।',
    ta: 'அதே ஹெர்பல் ஹேர் கேர் ஆயிலின் பெரிய 500 ml பாக்.',
    kn: 'ಅದೇ ಹೆರ್ಬಲ್ ಹೇರ್ ಕೇರ್ ಆಯಿಲ್‌ನ ದೊಡ್ಡ 500 ml ಪ್ಯಾಕ್.',
  },
  'hair-oil-1-ltr': {
    en: 'A one-litre format for regular use, listed in the current catalogue.',
    ml: 'സ്ഥിരമായ ഉപയോഗത്തിനുള്ള ഒരു ലിറ്റർ പായ്ക്ക്, നിലവിലെ കാറ്റലോഗിൽ.',
    hi: 'नियमित उपयोग के लिए एक लीटर पैक, वर्तमान कैटलॉग में सूचीबद्ध।',
    ta: 'வழக்கமான பயன்பாட்டிற்கான ஒரு லிட்டர் பாக், தற்போதைய பட்டியலில்.',
    kn: 'ನಿಯಮಿತ ಬಳಕೆಗಾಗಿ ಒಂದು ಲೀಟರ್ ಪ್ಯಾಕ್, ಪ್ರಸ್ತುತ ಪಟ್ಟಿಯಲ್ಲಿದೆ.',
  },
  'hair-oil-combo': {
    en: 'A combined listing of the herbal hair care oil in the store catalogue.',
    ml: 'സ്റ്റോർ കാറ്റലോഗിലെ ഹെർബൽ ഹെയർ കെയർ ഓയിലിന്റെ സംയോജിത ലിസ്റ്റിംഗ്.',
    hi: 'स्टोर कैटलॉग में हर्बल हेयर केयर ऑयल की संयुक्त लिस्टिंग।',
    ta: 'கடை பட்டியலில் ஹெர்பல் ஹேர் கேர் ஆயிலின் ஒருங்கிணைந்த பட்டியல்.',
    kn: 'ಅಂಗಡಿ ಪಟ್ಟಿಯಲ್ಲಿ ಹೆರ್ಬಲ್ ಹೇರ್ ಕೇರ್ ಆಯಿಲ್‌ನ ಸಂಯೋಜಿತ ಪಟ್ಟಿ.',
  },
};
---

<section id="showcase" class="section" aria-labelledby="showcase-title">
  <div class="shell">
    <p class="eyebrow-gold">{t.productLabel}</p>
    <h2 id="showcase-title">{t.productTitle}</h2>
    <p class="section-note">{t.productText}</p>

    <div class="featured-grid">
      {showcaseItems.map((item) => (
        <article class="featured-card" id={item.id}>
          {item.image && (
            <a class="featured-media" href={item.href} rel="noopener">
              <ApprovedImage
                lang={lang}
                image={item.image}
                sizes="(min-width: 1100px) 560px, (min-width: 760px) 45vw, 90vw"
              />
            </a>
          )}
          <div class="featured-body">
            <p class="eyebrow-gold">{groupCopy[item.group][lang].label}</p>
            <h3 lang="en">{item.officialName}</h3>
            <p>{descriptions[item.id][lang]}</p>
            <a class="featured-cta" href={item.href} rel="noopener">
              {t.buy}
              <ArrowIcon />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="collections" class="section" aria-labelledby="browse-title">
  <div class="shell">
    <p class="eyebrow-gold">{t.knowledgeLabel}</p>
    <h2 id="browse-title">{t.knowledgeTitle}</h2>
    <p class="section-note">{t.knowledgeText}</p>

    <div class="browse-grid">
      {browseGroups.map((group) => (
        <div class="browse-group">
          <h3>{groupCopy[group.id][lang].label}</h3>
          <p>{groupCopy[group.id][lang].blurb}</p>
          <ul class="browse-list">
            {group.items.map((item) => (
              <li>
                <a href={productHref(item.id)} rel="noopener" lang="en">
                  {item.officialName}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
