---
import ArrowIcon from './ArrowIcon.astro';
import ResponsiveFilm from './cinematic/ResponsiveFilm.astro';
import type { Dictionary, Locale } from '../i18n';
import '../styles/cinematic.css';
interface Props {
  t: Dictionary;
  lang: Locale;
}
const { t, lang } = Astro.props;
const c = t.cinematic;
---

<section id="story" class="cinema story-experience" aria-label={t.story}>
  <div
    class="cinema-hero"
    data-film-chapter="botanicals"
    data-headlines={JSON.stringify([t.hero, ...c.titles.slice(1)])}
    data-lines={JSON.stringify(c.notes)}
  >
    <ResponsiveFilm
      label={c.film}
      pending={c.videoPending}
      play={c.play}
      pause={c.pause}
      unavailable={c.unavailable}
      lang={lang}
    />
    <div class="cinema-hero-shade" aria-hidden="true"></div>
    <div class="cinema-hero-copy">
      <p class="eyebrow">{c.heroKicker}</p>
      <h1 id="hero-title">{t.hero}</h1>
      <p class="cinema-hero-line">{c.heroLine}</p>
      <a class="cinema-hero-action" href="#botanical-journey">
        {t.discover}
        <ArrowIcon direction="down" />
      </a>
    </div>
    <a class="skip-story" href="#ingredients">
      {t.skipStory}
    </a>
  </div>
  <h2 class="sr-only">{c.title}</h2>
  <!-- The film's eight chapters play inside the hero video itself. The previous
       eight photographic scene sections and the chapter navigation duplicated
       that story after the hero and have been removed on owner request. -->
</section>
<script>
  import { mountCinematicStory } from '../scripts/cinematic-story';
  document
    .querySelectorAll<HTMLElement>('.cinema')
    .forEach(mountCinematicStory);
</script>
