---
import ArrowIcon from './ArrowIcon.astro';
import ResponsiveFilm from './cinematic/ResponsiveFilm.astro';
import CinematicScene from './cinematic/CinematicScene.astro';
import assets from '../data/cinematic-assets.json';
import { featuredProduct, productPath } from '../data/products';
import type { Dictionary, Locale } from '../i18n';
import '../styles/cinematic.css';
interface Props {
  t: Dictionary;
  lang: Locale;
}
const { t, lang } = Astro.props;
const c = t.cinematic;
---

<section id="story" class="cinema story-experience" aria-label={t.story}>
  <div class="wrap">
    <div class="cinema-introduction">
      <div>
        <p class="eyebrow">{t.journal}</p>
        <h1 id="hero-title">{t.hero}</h1>
        <p class="lede">{t.intro}</p>
        <div class="actions">
          <a class="button button-gold" href="#story-scene-1">
            {t.scrollInvitation}
            <ArrowIcon direction="down" />
          </a>
          <a class="text-link skip-story" href="#ingredients">
            {t.skipStory}
            <ArrowIcon />
          </a>
        </div>
      </div>
      <ResponsiveFilm
        label={c.film}
        pending={c.videoPending}
        play={c.play}
        pause={c.pause}
        unavailable={c.unavailable}
      />
    </div>
    <div class="cinema-chapter-heading">
      <p class="eyebrow">{t.heritageLabel}</p>
      <h2>{c.title}</h2>
    </div>
    <nav class="cinema-chapters" aria-label={t.story}>
      {c.titles.map((title, index) => (
        <a href={`#story-scene-${index + 1}`} data-chapter-link>
          <span aria-hidden="true">0{index + 1}</span>
          <span>{title}</span>
        </a>
      ))}
    </nav>
    <div class="cinema-progress" aria-hidden="true">
      <span></span>
    </div>
    <ol class="cinema-scenes">
      {assets.scenes.map((scene, index) => (
        <CinematicScene
          scene={scene}
          index={index}
          title={c.titles[index]}
          description={c.notes[index]}
          pending={c.imagePending}
          lang={lang}
        >
          {index === 7 && (
            <a
              class="button button-gold"
              href={productPath(lang, featuredProduct)}
            >
              {t.viewDetails}
              <ArrowIcon />
            </a>
          )}
        </CinematicScene>
      ))}
    </ol>
    <p class="cinema-endnote">{c.originals}</p>
  </div>
</section>
<script>
  import { mountCinematicStory } from '../scripts/cinematic-story';
  document
    .querySelectorAll<HTMLElement>('.cinema')
    .forEach(mountCinematicStory);
</script>
