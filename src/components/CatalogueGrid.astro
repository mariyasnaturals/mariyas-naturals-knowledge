---
import ArrowIcon from './ArrowIcon.astro';
import ProductVisual from './ProductVisual.astro';
import { productPath, type Product } from '../data/products';
import type { Dictionary, Locale } from '../i18n';
interface Props {
  products: readonly Product[];
  t: Dictionary;
  lang: Locale;
}
const { products, t, lang } = Astro.props;
---

<div class="catalogue-grid">
  {products.map((product) => (
    <article class="catalogue-card">
      <a href={productPath(lang, product)}>
        <div class="catalogue-image">
          <ProductVisual
            product={product}
            lang={lang}
            t={t}
            sizes="(min-width: 1000px) 280px, (min-width: 760px) 42vw, 85vw"
          />
        </div>
        <h3 lang="en">{product.name[lang]}</h3>
        <span class="text-link">
          {t.viewDetails}
          <ArrowIcon />
        </span>
      </a>
    </article>
  ))}
</div>
