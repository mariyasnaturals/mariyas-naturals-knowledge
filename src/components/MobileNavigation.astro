---
import type { Locale, Dictionary } from '../i18n';
interface Props {
  lang: Locale;
  t: Dictionary;
}
const { lang, t } = Astro.props;
const prefix = Astro.url.pathname === `/${lang}/` ? '' : `/${lang}/`;
const links = [
  { label: t.home, href: `/${lang}/`, icon: 'M3 10 12 3l9 7v11h-6v-7H9v7H3Z' },
  {
    label: t.ingredients,
    href: `${prefix}#ingredients`,
    icon: 'M12 3C3 3 3 16 12 21c9-5 9-18 0-18Zm0 4v14',
  },
  {
    label: t.knowledge,
    href: `${prefix}#knowledge`,
    icon: 'M4 5h16M4 12h16M4 19h16',
  },
  {
    label: t.products,
    href: `/${lang}/products/`,
    icon: 'M4 4h6v6H4Zm10 0h6v6h-6ZM4 14h6v6H4Zm10 0h6v6h-6Z',
  },
];
---

<nav class="mobile-bottom-nav" aria-label={t.navLabel}>
  {links.map((link) => (
    <a
      href={link.href}
      aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
      >
        <path d={link.icon} />
      </svg>
      <span>{link.label}</span>
    </a>
  ))}
</nav>
