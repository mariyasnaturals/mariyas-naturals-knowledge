---
import ProductVisual from './ProductVisual.astro';
import { purchaseUrl, productPath, type Product } from '../data/products';
import type { Dictionary, Locale } from '../i18n';
interface Props {
  product: Product;
  t: Dictionary;
  lang: Locale;
}
const { product, t, lang } = Astro.props;
const storeUrl = purchaseUrl(product);
---

<article class="product-card">
  <div class="product-image">
    <ProductVisual product={product} lang={lang} t={t} />
  </div>
  <div class="product-copy">
    <p class="eyebrow">{product.demonstration ? t.demo : t.products}</p>
    <h3>{product.name[lang]}</h3>
    <p>{product.description[lang]}</p>
    <div class="actions">
      <a class="button" href={productPath(lang, product)}>
        {t.viewDetails} <span aria-hidden="true">→</span>
      </a>
      {storeUrl ? (
        <a class="text-link" href={storeUrl}>
          {t.buy}
        </a>
      ) : (
        <span class="pending">{t.commercePending}</span>
      )}
    </div>
  </div>
</article>
