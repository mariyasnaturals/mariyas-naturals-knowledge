---
import { purchaseUrl, type Product } from '../data/products';
import type { Dictionary } from '../i18n';
interface Props {
  product: Product;
  t: Dictionary;
}
const { product, t } = Astro.props;
const storeUrl = purchaseUrl(product);
---

<article class="product-card">
  <div class="product-image">
    {product.image ? (
      <img
        src={product.image.src}
        alt={product.image.alt}
        width={product.image.width}
        height={product.image.height}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="image-placeholder">
        <span aria-hidden="true">✧</span>
        <p>{t.imagePlaceholder}</p>
      </div>
    )}
  </div>
  <div class="product-copy">
    {product.demonstration && <p class="eyebrow">{t.demo}</p>}
    <h3>{t[product.nameKey]}</h3>
    <p>{t[product.shortDescriptionKey]}</p>
    <div class="actions">
      <a class="text-link" href={`#${product.slug}`}>
        {t.learn}
        <span class="sr-only">: {t[product.nameKey]}</span> →
      </a>
      {storeUrl ? (
        <a class="button" href={storeUrl}>
          {t.buy}
        </a>
      ) : (
        <span class="pending">{t.buyPending}</span>
      )}
    </div>
  </div>
</article>
