---
import ArrowIcon from './ArrowIcon.astro';
import ProductVisual from './ProductVisual.astro';
import { purchaseUrl, productPath, type Product } from '../data/products';
import type { Dictionary, Locale } from '../i18n';
interface Props {
  product: Product;
  t: Dictionary;
  lang: Locale;
}
const { product, t, lang } = Astro.props;
const storeUrl = purchaseUrl(product);
---

<article class="product-card">
  <a
    class="product-image"
    href={productPath(lang, product)}
    aria-label={product.name[lang]}
  >
    <ProductVisual
      product={product}
      lang={lang}
      t={t}
      sizes="(min-width: 1100px) 360px, (min-width: 760px) 40vw, 80vw"
    />
  </a>
  <div class="product-copy">
    <p class="eyebrow">{t.categories[product.category]}</p>
    <h3 lang="en">{product.name[lang]}</h3>
    <div class="actions">
      <a class="button" href={productPath(lang, product)}>
        {t.viewDetails}{' '}
        <span aria-hidden="true">
          <ArrowIcon />
        </span>
      </a>
      {storeUrl ? (
        <a class="text-link" href={storeUrl}>
          {t.buy}
        </a>
      ) : (
        <span class="pending">{t.commercePending}</span>
      )}
    </div>
  </div>
</article>
