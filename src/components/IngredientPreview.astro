---
import SectionHeading from './SectionHeading.astro';
import type { Dictionary } from '../i18n';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section id="ingredients" class="care-notes section">
  <div class="wrap">
    <SectionHeading
      eyebrow={t.ingredientLabel}
      title={t.ingredientTitle}
      text={t.ingredientText}
    />
    <ol class="ritual-notes">
      {t.ingredientItems.map((title, i) => (
        <li>
          <span class="scene-number" aria-hidden="true">
            0{i + 1}
          </span>
          <h3>{title}</h3>
          <p>{t.ingredientNotes[i]}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
