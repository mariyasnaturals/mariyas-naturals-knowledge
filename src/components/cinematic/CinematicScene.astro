---
import assets from '../../data/cinematic-assets.json';
import { sceneVisuals } from '../../data/cinematic-visuals.mjs';
import type { Locale } from '../../i18n';
interface Props {
  scene: (typeof assets.scenes)[number];
  index: number;
  title: string;
  description: string;
  pending: string;
  lang: Locale;
}
const { scene, index, title, description, pending, lang } = Astro.props;
const visuals = sceneVisuals(assets, scene);
const ready = visuals.length > 0;
---

<li
  id={`story-scene-${index + 1}`}
  class="cinema-scene"
  data-story-scene
  data-effect={scene.effect}
  data-scene-id={scene.id}
>
  <div class="cinema-scene-copy">
    <p class="eyebrow">
      <span aria-hidden="true">0{index + 1} / 08</span> · MARIYAS NATURALS
    </p>
    <h3>{title}</h3>
    <p>{description}</p>
    <slot />
  </div>
  <figure class="cinema-frame" data-asset-state={ready ? 'ready' : 'pending'}>
    {ready && (
      <div
        class:list={[
          'cinema-originals',
          { 'cinema-originals-pair': visuals.length > 1 },
        ]}
      >
        {visuals.map(({ id, asset }) => (
          <img
            src={asset.src}
            width={asset.width}
            height={asset.height}
            alt={asset.alt[lang]}
            loading="lazy"
            decoding="async"
            data-cinematic-asset={id}
          />
        ))}
      </div>
    )}
    <!-- Abstract light only: no stand-in packaging, faces or synthetic hair. -->
    {!ready && (
      <div class="cinema-atmosphere" aria-hidden="true">
        <span class="cinema-halo"></span>
        <span class="cinema-light"></span>
        <span class="cinema-sweep"></span>
      </div>
    )}
    {ready &&
      scene.effect === 'shine' &&
      assets.hairMask.status === 'ready' &&
      assets.hairMask.src && (
        <div
          class="cinema-hair-highlight"
          style={{ maskImage: `url(${assets.hairMask.src})` }}
          aria-hidden="true"
        >
          <span class="cinema-sweep"></span>
        </div>
      )}
    <figcaption>
      <span class="cinema-frame-index" aria-hidden="true">
        0{index + 1}
      </span>
      {!ready && pending}
    </figcaption>
  </figure>
</li>
