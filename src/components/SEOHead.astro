---
import { site, absoluteUrl } from '../config/site';
import { locales, type Locale } from '../i18n';
import { currentStoreOrigin } from '../config/media-policy.mjs';
import brandAssets from '../data/brand-assets.json';
interface Props {
  title: string;
  description: string;
  lang: Locale;
  path?: string;
  pageSchema?: Record<string, unknown>;
  socialImage?: { src: string; width: number; height: number; alt: string };
  /** Absolute canonical target when this page is a translation of another route. */
  canonicalPath?: string;
  /** Ordered trail below the language root; the home and language root are added. */
  breadcrumbs?: { name: string; path: string }[];
}
const {
  title,
  description,
  lang,
  path = Astro.url.pathname,
  socialImage,
  canonicalPath,
  breadcrumbs = [],
} = Astro.props;
const suffix = path.startsWith(`/${lang}/`) ? path.slice(lang.length + 2) : '';
const canonical = absoluteUrl(canonicalPath ?? path);
const ogLocale = {
  en: 'en_IN',
  ml: 'ml_IN',
  hi: 'hi_IN',
  ta: 'ta_IN',
  kn: 'kn_IN',
}[lang];
const social = socialImage ?? {
  src: brandAssets.social.ogDefault.path,
  width: brandAssets.social.ogDefault.width,
  height: brandAssets.social.ogDefault.height,
  alt: 'Mariyas Naturals — approved studio portrait with the official logo',
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: 'Mariyas Naturals',
      url: site.url,
      logo: {
        '@type': 'ImageObject',
        url: absoluteUrl(brandAssets.logo.full),
        width: brandAssets.logo.fullSize,
        height: brandAssets.logo.fullSize,
      },
      sameAs: [currentStoreOrigin, site.storeUrl],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: 'Mariyas Naturals',
      url: site.url,
      inLanguage: locales,
      publisher: { '@id': `${site.url}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { '@id': `${site.url}/#website` },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: absoluteUrl(social.src),
      },
      ...Astro.props.pageSchema,
    },
    ...(breadcrumbs.length
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonical}#breadcrumb`,
            itemListElement: [
              {
                '@type': 'ListItem',
                position: 1,
                name: 'Mariyas Naturals',
                item: absoluteUrl(`/${lang}/`),
              },
              ...breadcrumbs.map((crumb, index) => ({
                '@type': 'ListItem',
                position: index + 2,
                name: crumb.name,
                item: absoluteUrl(crumb.path),
              })),
            ],
          },
        ]
      : []),
  ],
};
---

<meta charset="UTF-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
/>
<title>{title} | Mariyas Naturals</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={site.indexable ? 'index, follow' : 'noindex, nofollow'}
/>
<link rel="canonical" href={canonical} />
{locales.map((locale) => (
  <link
    rel="alternate"
    hreflang={locale}
    href={absoluteUrl(`/${locale}/${suffix}`)}
  />
))}
<link
  rel="alternate"
  hreflang="x-default"
  href={absoluteUrl(`/en/${suffix}`)}
/>
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Mariyas Naturals" />
<meta property="og:title" content={`${title} | Mariyas Naturals`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteUrl(social.src)} />
<meta property="og:image:secure_url" content={absoluteUrl(social.src)} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(social.width)} />
<meta property="og:image:height" content={String(social.height)} />
<meta property="og:image:alt" content={social.alt} />
<meta property="og:locale" content={ogLocale} />
{locales
  .filter((locale) => locale !== lang)
  .map((locale) => (
    <meta
      property="og:locale:alternate"
      content={
        { en: 'en_IN', ml: 'ml_IN', hi: 'hi_IN', ta: 'ta_IN', kn: 'kn_IN' }[
          locale
        ]
      }
    />
  ))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} | Mariyas Naturals`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteUrl(social.src)} />
<meta name="twitter:image:alt" content={social.alt} />
<meta name="theme-color" content="#063D2A" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/brand/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/brand/favicon-16.png" type="image/png" sizes="16x16" />
<link
  rel="apple-touch-icon"
  href="/brand/apple-touch-icon.png"
  sizes="180x180"
/>
<link rel="manifest" href="/site.webmanifest" />
<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
/>
