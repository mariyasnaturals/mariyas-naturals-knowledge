---
interface Props {
  direction?: 'right' | 'left' | 'down';
}
const { direction = 'right' } = Astro.props;
---

<svg
  class:list={['arrow-icon', direction]}
  viewBox="0 0 24 24"
  width="18"
  height="18"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
  focusable="false"
>
  <path d="M4 12h15m-6-6 6 6-6 6" />
</svg>
