---
/**
 * Phase 6 — "Explore by Care".
 *
 * The long "03 / The Care Collection" link list becomes four visual doors into the
 * same catalogue: Hair, Baby, Skin, Wellness. Each tile links to the collection
 * page that already exists for that category, so nothing is orphaned and the full
 * catalogue is still reachable from the product and collection routes.
 *
 * Counts are computed from the catalogue at build time, never typed by hand, so a
 * tile can never advertise more products than the site can show.
 */
import ArrowIcon from '../ArrowIcon.astro';
import { products } from '../../data/products';
import { activeCollectionKeys, collectionPath } from '../../data/collections';
import { careExplorer } from '../../data/living-copy';
import { dict } from '../../i18n/living';
import type { Dictionary, Locale } from '../../i18n';
import type { ProductCategory } from '../../data/media-types';

interface Props {
  t: Dictionary;
  lang: Locale;
}

const { t, lang } = Astro.props;
const copy = {
  label: dict(careExplorer.label, lang),
  title: dict(careExplorer.title, lang),
  noteTemplate: dict(careExplorer.note, lang),
  count: dict(careExplorer.count, lang),
};

const icons: Record<string, string> = {
  'hair-care':
    'M9 21c-1-4.5-.6-8 1.2-10.4C11.8 8.4 13 6.4 12.6 3c3 1.6 4.6 4.4 4.4 7.4-.2 3-1.6 5.4-1.2 10.6M7.2 21c1-3.6.8-6.2-.6-8.2',
  'baby-care':
    'M8 8.4a4 4 0 1 1 8 0c0 1.2-.5 2.2-1.3 3 1.9 1 3.3 3 3.3 5.6v1H6v-1c0-2.6 1.4-4.6 3.3-5.6A4.2 4.2 0 0 1 8 8.4Zm2.4-.6h.01M13.6 7.8h.01',
  'skin-care':
    'M12 3.6c3.6 2.6 6 5.4 6 8.6a6 6 0 0 1-12 0c0-3.2 2.4-6 6-8.6Zm-2.4 6.6c0 2 1.6 3.4 3.4 3.4',
  wellness:
    'M12 20c-3.6 0-6-2.4-6-5.6C6 10.4 12 4.4 12 4.4s6 6 6 10c0 3.2-2.4 5.6-6 5.6Zm-3-6.6c1.2-1.6 2.4-2 3-2s1.8.4 3 2',
  'herbal-powders':
    'M6 20c0-6 3-11 6-13 3 2 6 7 6 13-2 1.2-4 1.8-6 1.8S8 21.2 6 20Zm6-9v8',
  combo: 'M4 9.5 12 5l8 4.5-8 4.5-8-4.5Zm0 5L12 19l8-4.5',
};

/**
 * The four doors the brief names, plus the two categories that hold a large share
 * of the live catalogue (herbal powders and kits/combos), so no product group is
 * unreachable from the homepage.
 */
const order: ProductCategory[] = [
  'hair-care',
  'baby-care',
  'skin-care',
  'wellness',
  'herbal-powders',
  'combo',
];

const tiles = order
  .filter((key) => activeCollectionKeys.includes(key))
  .map((key) => ({
    key,
    href: collectionPath(lang, key),
    label: t.categories[key],
    icon: icons[key] ?? icons['hair-care'],
    count: products.filter((product) => product.category === key).length,
  }));

/** The sentence counts the tiles on screen, never a remembered number. */
const note = copy.noteTemplate.replace('{count}', String(tiles.length));
---

<section
  id="care"
  class="lg-section lg-care-section"
  aria-labelledby="care-title"
>
  <div class="lg-shell">
    <div class="lg-heading lg-heading--start">
      <p class="lg-eyebrow">{copy.label}</p>
      <h2 id="care-title">{copy.title}</h2>
      <span class="lg-rule" aria-hidden="true"></span>
      <p data-care-note data-count={tiles.length}>
        {note}
      </p>
    </div>

    <ul class="lg-care" role="list">
      {tiles.map((tile) => (
        <li>
          <a class="lg-tile" href={tile.href}>
            <span class="lg-tile__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path
                  d={tile.icon}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="lg-tile__text">
              <span>{tile.label}</span>
              <small>
                {tile.count} {copy.count}
              </small>
            </span>
            <span class="lg-tile__arrow" aria-hidden="true">
              <ArrowIcon />
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="lg-care__more">
      <a class="lg-link" href={`/${lang}/products/`}>
        {t.catalogue}
      </a>
    </p>
  </div>
</section>

<style>
  .lg-care-section {
    background: var(--lg-ivory);
    border-top: 1px solid var(--lg-beige);
  }

  :global(.lg-tile__arrow) {
    display: none;
  }

  @media (min-width: 760px) {
    :global(.lg-tile__arrow) {
      display: grid;
      place-content: center;
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      width: 20px;
      height: 20px;
      color: var(--lg-gold);
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    :global(.lg-tile:hover .lg-tile__arrow),
    :global(.lg-tile:focus-visible .lg-tile__arrow) {
      opacity: 1;
    }
  }

  .lg-care__more {
    margin: 1.25rem 0 0;
    text-align: center;
  }
</style>
