---
interface Props {
  number: number;
  title: string;
  description: string;
}
const { number, title, description } = Astro.props;
---

<li class="story-scene" data-story-scene>
  <span class="scene-number" aria-hidden="true">
    0{number}
  </span>
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</li>
