# Design references (competitor and third-party captures) are design intent only.
# They are never site assets, so only the written intent is tracked.
docs/reference/**/*.jpg
docs/reference/**/*.jpeg
docs/reference/**/*.png
docs/reference/**/*.webp

# Local tool caches (browser binaries, extracted libraries) never belong in Git.
.cache/
